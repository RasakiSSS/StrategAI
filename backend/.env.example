# =============================================================================
# StrategAI Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is loaded automatically by python-dotenv at startup
# (called in app/engine/openai_goals.py). Place this file in the backend/
# directory — the same directory from which you run uvicorn.
# =============================================================================

# ---------------------------------------------------------------------------
# OpenAI API Key — REQUIRED
# ---------------------------------------------------------------------------
# Used by:
#   - AI civilization goal sources (LLM-driven strategic decisions)
#   - Audio narration endpoint (text-to-speech intro)
#
# Without this key:
#   - AI civs fall back to RandomGoalSource (deterministic stub)
#   - The /audio/intro endpoint returns HTTP 503
#   - Human players can still play normally
#
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# OpenAI TTS Model — Optional
# ---------------------------------------------------------------------------
# Model used for the intro narration voiceover (/audio/intro endpoint).
# Must be a TTS-capable OpenAI model.
# Default: gpt-4o-mini-tts
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---------------------------------------------------------------------------
# OpenAI TTS Voice — Optional
# ---------------------------------------------------------------------------
# Voice preset for the intro narration.
# Supported OpenAI TTS voices: alloy, ash, cedar, coral, echo, fable, onyx,
# nova, sage, shimmer.
# Default: cedar
# OPENAI_TTS_VOICE=cedar

# =============================================================================
# Runtime AI battle configuration
# =============================================================================
# The Web API accepts a per-seat `llm_players` list when creating an AI battle:
#   mode: ai_battle
#   num_civs: 2..4
#   llm_players: [{model, base_url, api_key, label, temperature}, ...]
#
# These credentials are kept only in the backend process for the game session
# and are never included in GameState responses. Do not put provider keys in
# NEXT_PUBLIC_* frontend variables.
# If a seat omits api_key/model/base_url, OPENAI_API_KEY and the default model
# are used. Missing credentials retain the deterministic RandomGoalSource
# fallback used by the original human-vs-AI demo.
#
# AI battle endpoints:
#   POST /games (mode=ai_battle)
#   GET  /games/{id}/spectate
#   POST /games/{id}/run|pause|resume|stop
#   GET  /games/{id}/status
# =============================================================================
